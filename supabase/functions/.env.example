# Never commit the real .env file. Configure these values in Supabase Dashboard > Edge Functions > Secrets.
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=""
PAYMOB_PAYOUT_CLIENT_ID=
PAYMOB_PAYOUT_CLIENT_SECRET=
PAYMOB_PAYOUT_USERNAME=
PAYMOB_PAYOUT_PASSWORD=
# Add this only after Paymob supplies the webhook signing algorithm and secret.
PAYMOB_WEBHOOK_HMAC_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encode the PEM private key returned by Mux before setting this value.
MUX_SIGNING_KEY_PRIVATE_BASE64=